# ============================================================================
# EFFEN Social Content Studio — environment reference
# Copy to .env.local (web) — the worker reads the same file from the repo root.
# Client-exposed vars MUST be prefixed NEXT_PUBLIC_. Everything else is
# server-only and must never be imported into client components.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service-role/secret key. Required by the media worker and job dispatch.
# Dashboard -> Project Settings -> API keys. NEVER expose to the browser.
SUPABASE_SECRET_KEY=

# --- Mode -------------------------------------------------------------------
# mock = deterministic AI/provider fixtures, no external spend (default)
# live = real providers for anything with credentials configured
EFFEN_MODE=mock

# --- Storage ----------------------------------------------------------------
# local = filesystem under EFFEN_LOCAL_STORAGE_DIR served via signed URLs (dev)
# r2    = Cloudflare R2 (S3-compatible)
EFFEN_STORAGE=local
EFFEN_LOCAL_STORAGE_DIR=./data/storage
# Secret used to sign local upload/read URLs (any long random string).
EFFEN_SIGNING_SECRET=change-me-to-a-long-random-string
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=effen-media

# --- Job queue --------------------------------------------------------------
# db     = durable Postgres-backed queue polled by the worker (dev default)
# qstash = Upstash QStash push delivery (production)
EFFEN_QUEUE=db
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public URL of the worker's webhook endpoint (qstash mode only)
WORKER_WEBHOOK_URL=

# --- AI providers (live mode only) ------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional per-operation model overrides (see packages/core/src/ai/routing.ts)
# EFFEN_MODEL_VIDEO_UNDERSTANDING=
# EFFEN_MODEL_TRANSCRIPTION=
# EFFEN_MODEL_FRAME_OCR=
# EFFEN_MODEL_IDEAS=
# EFFEN_MODEL_RESEARCH=
# EFFEN_MODEL_HOOKS=
# EFFEN_MODEL_SCRIPT=
# EFFEN_MODEL_SCRIPT_REVISION=

# --- Ingestion providers (live mode only) -----------------------------------
YOUTUBE_API_KEY=
APIFY_TOKEN=
# Webhook signature secret you configure on Apify webhooks
APIFY_WEBHOOK_SECRET=
